# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# fal.ai API key, used for generating project images.
# Get one at https://fal.ai/dashboard/keys
FAL_KEY=

# Higgsfield API credentials, used for video generation (Wan 3.0 Prime).
# Format is KEY_ID:KEY_SECRET. Get one at https://console.higgsfield.ai
HF_KEY=
